{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"]
  },
  "include": [
    "protocol-config/**/*.ts",
    "hardhat.config.ts",
    "helper-hardhat-config.ts",
    "helpers/**/*.ts",
    "tasks/**/*.ts",
    "deploy/**/*.ts",
    "test/hardhat/**/*.ts",
    "script/**/*.ts"
  ]
}
